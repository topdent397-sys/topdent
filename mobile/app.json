{
  "expo": {
    "name": "TopDent",
    "slug": "topdent",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "topdent",
    "icon": "./assets/logo-mark.png",
    "splash": {
      "backgroundColor": "#0b3b8f"
    },
    "android": {
      "package": "com.topdent.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0b3b8f"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-image-picker",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://topdent-production-654a.up.railway.app/api"
    }
  }
}
